<?xml version="1.0" encoding="utf-8"?>
<!-- Figma L/06 홈: 상단 탭 → 인사말 → 추천 연습 카드(왼쪽) + 일반 주행·차량 상태·운전 지식(오른쪽 600) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Tabs: px40 gap8, 아래 구분선 2 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:background="@color/pleos_ink_10" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <TextView
                android:id="@+id/nav_home"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="홈" />

            <TextView
                android:id="@+id/nav_knowledge"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="운전 지식" />

            <TextView
                android:id="@+id/nav_help"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="차량 도움" />

            <TextView
                android:id="@+id/nav_settings"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="설정" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- Body: px40 py24 gap40 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="24dp"
            android:paddingEnd="40dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/date"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/greeting"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="안녕하세요, 오늘은 어디로 갈까요?" />

            <TextView
                android:id="@+id/cabin_temp"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Dashboard: gap24 -->
            <LinearLayout
                android:id="@+id/dashboard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <!-- Practice Card: p40, 모서리 48 -->
                <LinearLayout
                    android:id="@+id/practice_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_large"
                    android:orientation="vertical"
                    android:padding="40dp">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘의 추천 연습" />

                    <TextView
                        android:id="@+id/rec_title"
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="동네에서 유턴 1번" />

                    <TextView
                        android:id="@+id/rec_meta"
                        style="@style/Text.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="약 15분 · 넓은 길 · 한산한 시간" />

                    <TextView
                        android:id="@+id/rec_reason"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="40dp" />

                    <Button
                        android:id="@+id/btn_practice"
                        style="@style/Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_min"
                        android:text="연습 시작" />
                </LinearLayout>

                <!-- Side: 600, gap24 -->
                <LinearLayout
                    android:id="@+id/side"
                    android:layout_width="600dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="32dp">

                        <TextView
                            style="@style/Text.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="일반 주행" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="설정한 안내량으로 편하게 달려요" />

                        <Button
                            android:id="@+id/btn_drive"
                            style="@style/Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/touch_min"
                            android:layout_marginTop="24dp"
                            android:text="주행 시작" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="32dp">

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="차량 상태" />

                            <TextView
                                android:id="@+id/vehicle_status"
                                style="@style/Text.Headline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                tools:text="이상 없음" />

                            <TextView
                                android:id="@+id/vehicle_connection"
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="24dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="32dp">

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="주행 가능 거리" />

                            <TextView
                                android:id="@+id/fuel"
                                style="@style/Text.Headline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                tools:text="300 km" />

                            <TextView
                                android:id="@+id/fuel_note"
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="32dp">

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="오늘의 운전 지식" />

                        <TextView
                            android:id="@+id/tip"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            tools:text="비보호 좌회전은 맞은편 차가 끊길 때 해요" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
