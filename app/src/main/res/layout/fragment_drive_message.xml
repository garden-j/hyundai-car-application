<?xml version="1.0" encoding="utf-8"?>
<!-- Figma L/20 릴렉스 안내 · L/21 음성 확인 질문: 모드 표시 · 큰 문장 · 보조 문장 · 음성 상태 · 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="56dp">

    <TextView
        android:id="@+id/mode"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_ink"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/white"
        tools:text="연습 모드" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="pretendard"
        android:lineHeight="110sp"
        android:textColor="@color/text_primary"
        android:textFontWeight="800"
        android:textSize="88sp"
        tools:text="숨을 길게\n내쉬어 볼까요" />

    <TextView
        android:id="@+id/sub"
        style="@style/Text.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        tools:text="안내를 조금 더 자세히 해 드릴게요" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_mic"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_mic_accent"
                    android:contentDescription="@string/mic">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_mic_white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/voice_status"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/text_primary"
                    tools:text="음성으로 안내하고 있어요" />
            </LinearLayout>

            <TextView
                android:id="@+id/voice_line"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="“서두르지 않아도 괜찮아요”" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_secondary"
                style="@style/Button.Secondary"
                android:layout_width="280dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginEnd="16dp"
                tools:text="아니요" />

            <Button
                android:id="@+id/btn_primary"
                style="@style/Button.Primary"
                android:layout_width="360dp"
                android:layout_height="@dimen/touch_min"
                tools:text="네" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
