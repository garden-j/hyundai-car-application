<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 듣는 중 -->
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/pleos_selected" />
            <stroke android:width="2dp" android:color="@color/pleos_ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pleos_surface" />
            <stroke android:width="2dp" android:color="@color/pleos_ink" />
        </shape>
    </item>
</selector>
